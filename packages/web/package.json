{
  "name": "ckb-up-down-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Player-facing web frontend for CKB Up/Down. Reads the watcher REST API; the watcher also BUILDS deposit/redeem/burn txs server-side — the browser only signs (CCC wallet) + submits. No project SDK ships to the client.",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@ckb-ccc/connector-react": "^1.0.35",
    "@ckb-ccc/core": "^1.12.2",
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
