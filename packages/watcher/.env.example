# Watcher service configuration. Copy to .env and fill in.

# --- network / chain ---
WATCHER_NETWORK=devnet
WATCHER_CKB_RPC_URL=http://127.0.0.1:8114

# --- role / lane selection ---
# all | keeper | indexer | oracle. "all" runs everything in one process (single
# wallet); the compose file overrides this per service for the role-split deployment
# (one indexer + one oracle writer + one keeper per feed).
WATCHER_ROLE=all
# Comma-list of lane labels this process runs (empty = all configured). A per-feed
# keeper runs ALL of its feed's durations (leave empty), so their coincident
# boundaries batch onto the one oracle cell. Known labels: BTC-5m,BTC-15m,BTC-1h,BTC-1d.
WATCHER_LANES=
# Grid anchor (unix seconds) for the rolling-create schedule: rounds tile time at
# firstCreateAt + k*duration. Empty/0 = epoch-aligned (:00/:05/… UTC). One shared
# anchor for the whole board keeps coarse boundaries coincident with fine ones (so
# cross-cadence transitions can batch onto the one per-feed oracle cell).
WATCHER_FIRST_CREATE_AT=0

# --- keeper identity (owns every created pool; funds fees) ---
# Devnet-only dummy key. NEVER use a funded mainnet key here.
# The oracle writer and the BTC keeper each want their OWN wallet so they don't
# contend over cells; compose reads WATCHER_KEY_ORACLE / WATCHER_KEY_BTC (each
# falling back to this one for a single-wallet devnet run).
WATCHER_CREATOR_PRIVATE_KEY=0x...
WATCHER_KEY_ORACLE=
WATCHER_KEY_BTC=
# When the keeper uses a different wallet than the indexer, list the keeper's
# creator-lock hash(es) here so the single indexer projects the keeper's pools.
WATCHER_OPERATOR_LOCK_HASHES=

# --- oracle wiring (oracle + keeper roles) ---
# WATCHER_ORACLE=live wires a real Lean Oracle cell; anything else uses the no-op stub
# (pools stay OPEN, never LOCK/SETTLE). WATCHER_ORACLE_CONFIG points at the Lean Oracle
# network JSON. The lane oracle identity is derived from it so pool oracle_commit matches.
WATCHER_ORACLE=stub
WATCHER_ORACLE_CONFIG=./lean-oracle.devnet.json

# --- service knobs ---
WATCHER_API_PORT=8080
WATCHER_INDEX_SECS=15
WATCHER_DB_PATH=./data/watcher.db

# --- offckb devnet secp256k1_blake160 override (from `offckb deployed-scripts`) ---
DEVNET_SECP256K1_BLAKE160_CODE_HASH=0x...
DEVNET_SECP256K1_BLAKE160_HASH_TYPE=type
DEVNET_SECP256K1_BLAKE160_DEP_TX_HASH=0x...
DEVNET_SECP256K1_BLAKE160_DEP_INDEX=0
DEVNET_SECP256K1_BLAKE160_DEP_TYPE=depGroup
