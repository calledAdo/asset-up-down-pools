# --- Watcher backend: serves reads AND builds the write transactions ---
VITE_WATCHER_API_URL=http://127.0.0.1:8080

# --- CKB network the wallet talks to: devnet | testnet | mainnet ---
VITE_CKB_NETWORK=devnet

# --- CKB JSON-RPC the wallet client uses (devnet → local node) ---
VITE_CKB_RPC_URL=http://127.0.0.1:8114
